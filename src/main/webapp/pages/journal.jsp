<%@ page import="com.moodcanvas.model.User" contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><% if(session.getAttribute("user")==null){response.sendRedirect(request.getContextPath()+"/pages/signin.html");return;} %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html lang="en"><head><base href="<%=request.getContextPath()%>/pages/"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My art journal — MoodCanvas</title><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet"><link rel="stylesheet" href="../css/style.css"></head><body><%@ include file="header.jspf" %><main class="app-main wrap"><section class="welcome-row"><div><span class="eyebrow">A COLLECTION OF YOUR MOMENTS</span><h1>Your art <em>journal.</em></h1><p>The pieces that found you along the way.</p></div><span class="welcome-flower">♡</span></section><div class="journal-grid" id="journalGrid"><c:choose><c:when test="${empty journalEntries}"><div class="journal-empty"><span>✿</span><h2>Your art journal is empty.</h2><p>Start exploring to save pieces that move you.</p><a class="button" href="dashboard.jsp">Find your art <span>↗</span></a></div></c:when><c:otherwise><c:forEach var="entry" items="${journalEntries}"><article class="journal-card" data-journal-id="${entry.journalID}"><div class="journal-image"><img src="<c:out value='${entry.imageURL}'/>" alt="<c:out value='${entry.title}'/>"><span class="museum-badge"><c:out value="${entry.museum}"/></span></div><div class="journal-info"><span class="journal-date">Saved <c:out value="${entry.savedAt}"/></span><h2><c:out value="${entry.title}"/></h2><p><c:out value="${entry.artist}"/></p><button class="remove-button" data-id="${entry.journalID}" type="button">Remove <span>×</span></button></div></article></c:forEach></c:otherwise></c:choose></div><footer class="app-footer"><span>A little gallery of your inner world</span><span>Made for the way you feel <b>♡</b></span></footer></main><div id="toast" class="toast" role="status"></div><script src="../js/journal.js" defer></script></body></html>
