<servlet><servlet-name>AdminServlet</servlet-name><servlet-class>com.moodcanvas.servlet.AdminServlet</servlet-class></servlet><servlet-mapping><servlet-name>AdminServlet</servlet-name><url-pattern>/admin</url-pattern></servlet-mapping>
